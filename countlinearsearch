package javabasics;

public class countlinearsearch 
{
	
	public static void main(String[] args) 
	{
		int[] arr= {5,7,1,4,9,1,3,2,1};
		
		int target=1;
		
		int count=0;
		
		for(int i=0;i<arr.length;i++)
		{
			if(arr[i]==target)
			{
				count++;
			}
		}
		
		System.out.println(target+" occurs "+count+" times");
		
	}

}

